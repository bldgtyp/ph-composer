#!/bin/sh
# The repository's pre-commit hook, installed by `make hooks` (or automatically by `make lint`, `make test`,
# `make ci` or `pnpm install`). The checks are in tools/githooks/staged_checks.py; docs/DEVELOPMENT.md,
# "Git hooks", says what runs. Do not bypass it with --no-verify.
# A GUI git client starts hooks with a minimal PATH, so the usual install locations of uv, Homebrew,
# rbenv and pnpm are added first. The script needs only the standard library, so it runs on the system
# python3 and a commit that needs no check never touches the project environment.
PATH="$HOME/.local/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.rbenv/shims:$HOME/Library/pnpm:$PATH"
export PATH
cd "$(git rev-parse --show-toplevel)" || exit 1
if command -v python3 >/dev/null 2>&1; then
  exec python3 tools/githooks/staged_checks.py pre-commit "$@"
elif command -v uv >/dev/null 2>&1; then
  exec uv run --quiet --no-project python tools/githooks/staged_checks.py pre-commit "$@"
fi
echo "pre-commit: neither python3 nor uv is on PATH (docs/DEVELOPMENT.md, Prerequisites). Nothing was committed."
exit 1
