#!/bin/sh
# The repository's commit-msg hook, installed by `make hooks` (or automatically by `make lint`, `make test`,
# `make ci` or `pnpm install`). The checks are in tools/githooks/staged_checks.py; docs/DEVELOPMENT.md,
# "Git hooks", says what runs. Do not bypass it with --no-verify.
# A GUI git client starts hooks with a minimal PATH, so the usual install locations of uv, Homebrew and
# rbenv are added first.
PATH="$HOME/.local/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.rbenv/shims:$PATH"
export PATH
if ! command -v uv >/dev/null 2>&1; then
  echo "commit-msg: uv is not on PATH; install it (docs/DEVELOPMENT.md, Prerequisites). Nothing was committed."
  exit 1
fi
cd "$(git rev-parse --show-toplevel)" || exit 1
exec uv run --quiet python tools/githooks/staged_checks.py commit-msg "$@"
