# The house supply-chain settings, on for this repo rather than only on the machine that happens
# to run the install: a package version has to have been public for a day before it is eligible,
# and a dependency may not resolve to a tarball, git or other non-registry source. The registry
# itself is pnpm's default; nothing here changes it.
minimum-release-age=1440
block-exotic-subdeps=true
